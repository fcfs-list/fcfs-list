# PostgreSQL connection used by Docker Compose
DB_USERNAME=fcfs_list
DB_PASSWORD=replace-with-a-local-password
DB_NAME=fcfs_list
DB_PORT=5432

# Auth0 API configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_RULE_NAMESPACE=https://your-auth0-namespace/

# Google Cloud Storage (needed for product image uploads)
GCS_BUCKET=your-gcs-bucket
GCLOUD_PROJECT=your-gcp-project-id
# Place the service-account JSON at this path; do not commit the credential file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-application-credentials.json
